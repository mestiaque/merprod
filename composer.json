{
    "name": "mestiaque/merchandising-sfl",
    "description": "Merchandising module (Master Data, Dev, Order + BOM, Sample Stages) for Laravel (Suhana Fashions Limited) by M. Estiaque Ahmed Khan",
    "type": "library",
    "keywords": [
        "Laravel",
        "MerchandisingSfl",
        "Merchandising",
        "Estiaque"
    ],
    "authors": [
        {
            "name": "M. Estiaque Ahmed Khan",
            "email": "mrm.khan.1298@gmail.com",
            "homepage": "https://mestiaque.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ME\\MerchandisingSfl\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ME\\MerchandisingSfl\\MerchandisingSflServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true
}
